# ==============================================================================
# Telegram Agent - complete configuration reference
#
# Every variable the agent reads is listed here. `agent doctor` reports any key in
# your .env that is NOT in this list, so a typo cannot fail silently.
#
# Precedence, highest first:
#   process environment  >  .env  >  config/config.yaml  >  config/defaults/default.yaml
#
# `agent setup` writes this file for you and preserves anything it does not manage.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# production keeps logs at INFO; any other value defaults them to DEBUG.
APP_ENV=production
# Explicit override for the log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# IANA timezone. /remind 18:00 and cron fields are interpreted in this zone.
# Examples: Asia/Jakarta, Europe/Berlin, America/New_York, UTC.
TIMEZONE=UTC
# Language of the wizard and of every bot reply: en or id. Users can change it
# per-chat with /lang.
UI_LANG=en

# ------------------------------------------------------------------------------
# Telegram
# ------------------------------------------------------------------------------
# Get this from @BotFather. Verified live by the setup wizard.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Get your own ID from @userinfobot. EMPTY MEANS ANYONE WHO FINDS THE BOT CAN USE IT.
TELEGRAM_ALLOWED_USERS=

# Comma-separated user IDs allowed to run /admin (operator diagnostics).
ADMIN_TELEGRAM_USERS=

ENABLE_PRIVATE_CHAT=true
ENABLE_GROUP_CHAT=false

# ------------------------------------------------------------------------------
# AI provider
#
# Supported: 9router | deepseek | anthropic | google | openai | openrouter |
#            ollama | opencode-zen | opencode-go | custom
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o
# Only needed for gateways and self-hosted endpoints, e.g. http://localhost:20128/v1
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# Local OpenCode session bridge (`opencode serve`) used by /oc and the mirror mode.
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# ------------------------------------------------------------------------------
# Extra providers for runtime switching (/provider in Telegram)
#
# Add credentials for any other provider you want to switch to without editing
# this file and restarting. Providers without credentials are listed by /provider
# as "no credentials" and cannot be selected.
# ------------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
# GOOGLE_API_KEY=
# GOOGLE_BASE_URL=
# GOOGLE_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# NINE_ROUTER_API_KEY=
# NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# NINE_ROUTER_MODEL=
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://api.opencode.ai/v1
# OPENCODE_ZEN_MODEL=
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://go.opencode.ai/v1
# OPENCODE_GO_MODEL=
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_MODEL=

# ------------------------------------------------------------------------------
# Agent persona
# ------------------------------------------------------------------------------
AGENT_NAME=Assistant
AGENT_PERSONALITY=Professional
AGENT_SYSTEM_PROMPT=You are a helpful and accurate AI assistant. You answer queries concisely and use tools when needed.

# ------------------------------------------------------------------------------
# Tools
#
# Every tool below is ON unless you set it to false. Tools marked HIGH RISK ask for
# an inline button confirmation in Telegram before they run.
# ------------------------------------------------------------------------------
ENABLE_WEB_SEARCH=true
ENABLE_HTTP_FETCH=true
HTTP_FETCH_TIMEOUT_SECONDS=15
ENABLE_CHART=true
ENABLE_PYTHON_SANDBOX=true
PYTHON_SANDBOX_TIMEOUT_SECONDS=5
ENABLE_WEATHER=true
WEATHER_TIMEOUT_SECONDS=12

# GitHub REST tool. A token raises the rate limit and enables private repos.
ENABLE_GITHUB=true
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
# false keeps the GitHub tool read-only (no issue creation).
GITHUB_ALLOW_WRITE=false

# Filesystem workspace for the file_read/file_write/file_edit/file_delete/dir_list tools.
ENABLE_FILESYSTEM=true
# '.' gives the agent the whole project directory; './data' is a sandbox.
FILESYSTEM_ROOT_DIR=.
# true = the agent may only read; false = it can write, edit and delete.
FILESYSTEM_READ_ONLY=false

# HIGH RISK: arbitrary shell command execution. Off by default.
ALLOW_SHELL=false
# Only meaningful when ALLOW_SHELL=true: allows commands like rm -rf.
ALLOW_DESTRUCTIVE_SHELL=false
SHELL_TIMEOUT_SECONDS=30
# Ask for an inline confirmation before running a high-risk tool. Set false only
# if you accept that destructive tools run unattended.
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true

# ------------------------------------------------------------------------------
# Storage and memory
# ------------------------------------------------------------------------------
MEMORY_ENABLED=true
STORAGE_PROVIDER=sqlite
DATABASE_PATH=data/agent.db
# Delete stored memories older than this many days. 0 keeps them forever.
DATA_RETENTION_DAYS=0

# ------------------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=15
