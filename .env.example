# ==============================================================================
# Telegram Agent Configuration
# ==============================================================================

# Application Environment (development, production)
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# Telegram Configuration
# ------------------------------------------------------------------------------
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of allowed Telegram User IDs (e.g. 123456789,987654321)
# Leave empty to require manual authorization
TELEGRAM_ALLOWED_USERS=

# Comma-separated list of admin user IDs for maintenance commands
ADMIN_TELEGRAM_USERS=

# Telegram operational modes: polling | webhook
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=

# Chat access flags
ENABLE_PRIVATE_CHAT=true
ENABLE_GROUP_CHAT=false

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Supported: 9router, deepseek, anthropic, google, openai, openrouter, ollama, opencode-zen, opencode-go, custom
# This is the DEFAULT provider used at startup.
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o
AI_BASE_URL=

# ------------------------------------------------------------------------------
# Extra providers for runtime switching (Telegram /provider command)
# ------------------------------------------------------------------------------
# Add credentials for any other provider you want to switch to at runtime.
# Unconfigured providers simply show as "no credentials" and cannot be selected.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# NINE_ROUTER_API_KEY=
# NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://api.opencode.ai/v1
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://go.opencode.ai/v1
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1

# OpenCode server URL for local terminal session bridge (opencode serve)
# Default: http://127.0.0.1:4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# Agent Persona & Behavior
# ------------------------------------------------------------------------------
AGENT_NAME=Assistant
AGENT_PERSONALITY=Professional
AGENT_SYSTEM_PROMPT=You are a helpful and accurate AI assistant. You answer queries concisely and use tools when needed.

# ------------------------------------------------------------------------------
# Integrations & Tools
# ------------------------------------------------------------------------------
ENABLE_WEB_SEARCH=true
ENABLE_GITHUB=true
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
GITHUB_ALLOW_WRITE=false

ENABLE_FILESYSTEM=true
# Workspace root for file read/write/edit/delete tools.
# Set to '.' (repo root / current working dir) for a real coding workspace.
# Default './data' is a restricted sandbox.
FILESYSTEM_ROOT_DIR=.
# false = allow the agent to write/edit/delete files (real coding).
FILESYSTEM_READ_ONLY=false

# Dangerous tool protections
ALLOW_SHELL=false
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true

# ------------------------------------------------------------------------------
# Storage & Memory
# ------------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_PROVIDER=sqlite
DATABASE_PATH=data/agent.db
MEMORY_RETENTION_DAYS=0

# ------------------------------------------------------------------------------
# Rate Limiting & Safety
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=15
DAILY_BUDGET_USD=5.00
