{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelegramAgentConfig",
  "description": "Shape of the resolved configuration. The authoritative defaults live in config/defaults/default.yaml and src/application/config_manager.py; this document is linted against the provider enum by tests/unit/test_provider_schema.py.",
  "type": "object",
  "required": ["telegram", "ai", "agent"],
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "env": { "type": "string", "enum": ["development", "production", "testing"], "default": "production" },
        "log_level": { "type": "string", "enum": ["", "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"], "default": "INFO" },
        "timezone": {
          "type": "string",
          "default": "UTC",
          "description": "IANA timezone used to interpret and display /remind and /schedule times."
        }
      }
    },
    "telegram": {
      "type": "object",
      "required": ["bot_token"],
      "properties": {
        "bot_token": { "type": "string", "minLength": 10 },
        "allowed_users": { "type": "array", "items": { "type": "integer" } },
        "admin_users": { "type": "array", "items": { "type": "integer" } },
        "enable_private_chat": { "type": "boolean", "default": true },
        "enable_group_chat": { "type": "boolean", "default": false }
      }
    },
    "ai": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "enum": ["9router", "deepseek", "anthropic", "google", "openai", "openrouter", "ollama", "opencode-zen", "opencode-go", "opencode", "custom"] },
        "api_key": { "type": "string" },
        "model": { "type": "string" },
        "base_url": { "type": "string", "default": "" },
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0, "default": 0.2 },
        "max_tokens": { "type": "integer", "default": 2048 },
        "timeout_seconds": { "type": "number", "default": 60.0 },
        "opencode_server_url": { "type": "string", "default": "http://127.0.0.1:4096" }
      }
    },
    "providers": {
      "type": "object",
      "description": "Optional per-provider credentials enabling runtime /provider switching.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "api_key": { "type": "string" },
          "base_url": { "type": "string" },
          "model": { "type": "string" }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "Assistant" },
        "personality": { "type": "string", "default": "Professional" },
        "system_prompt": { "type": "string" }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "web_search": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "http_fetch": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "timeout_seconds": { "type": "number" }
          }
        },
        "chart": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "python_sandbox": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "timeout_seconds": { "type": "number" }
          }
        },
        "weather": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "timeout_seconds": { "type": "number" }
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "token": { "type": "string" },
            "default_repo": { "type": "string" },
            "allow_write": { "type": "boolean" }
          }
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "root_dir": { "type": "string" },
            "read_only": { "type": "boolean" }
          }
        },
        "shell": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allow_destructive": { "type": "boolean" },
            "timeout_seconds": { "type": "number" }
          }
        },
        "require_confirmation_for_destructive": { "type": "boolean", "default": true }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "memory_enabled": { "type": "boolean", "default": true },
        "provider": { "type": "string", "enum": ["sqlite", "none"], "default": "sqlite" },
        "database_path": { "type": "string", "default": "data/agent.db" },
        "retention_days": { "type": "integer", "default": 0 }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "rate_limit_per_minute": { "type": "integer", "default": 15 }
      }
    }
  }
}
